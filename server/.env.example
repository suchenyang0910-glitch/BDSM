# 复制为 server/.env 后再填真实值，server/.env 已应被 .gitignore 忽略
DATABASE_URL="postgresql://intune:intune_dev_password@localhost:5432/intune?schema=public"

# Telegram 公开配置（可公开）
TELEGRAM_BOT_USERNAME="InTune_bdsm_bot"
PUBLIC_CHANNEL_URL="https://t.me/InTune_bdsm"

# Telegram 敏感配置 —— 真实值只允许存在于已部署机的实际 env 文件，禁止入库
# 多 Bot 登录白名单：用户从任一已授权 Bot 打开 Mini App 后，均按同一 Telegram User ID 归并账户。
# Token 仅可存在部署环境；禁止写入数据库、前端或仓库。旧 TELEGRAM_BOT_TOKEN 仅作单 Bot 开发兼容。
# 每个 Bot 的入口链接使用 https://t.me/<bot>?startapp=<key>，例如 primary / backup。
TELEGRAM_BOTS='[{"key":"primary","username":"InTune_bdsm_bot","token":"123456789:AAH_REPLACE_PRIMARY_TOKEN","active":true},{"key":"backup","username":"InTune_backup_bot","token":"123456789:AAH_REPLACE_BACKUP_TOKEN","active":true}]'
# 负责创建收费频道邀请链接的管理员 Bot key；它可与用户登录 Bot 不同。
TELEGRAM_INVITE_BOT_KEY="primary"
# 2) 收费频道数字 ID（@InTune_bdsm_bot 必须是这些频道管理员，且有权限创建邀请链接+管理成员）
#    通过你自己的 Bot 日志或受控后台记录获取；不要写入前端或公开聊天。
TELEGRAM_CHANNEL_MEMBERSHIP="-1000000000001"
TELEGRAM_CHANNEL_PACKAGE_FEATURED="-1000000000002"
TRON_GRID_BASE_URL="https://api.trongrid.io"
TRON_GRID_API_KEY="REPLACE_WITH_SERVER_SIDE_TRONGRID_API_KEY"
USDT_MONITOR_POLL_INTERVAL_MS="15000"
USDT_MONITOR_LOOKBACK_MS="3600000"
USDT_MONITOR_MAX_ADDRESSES_PER_CYCLE="100"
USDT_CONFIRMATIONS_TARGET="19"
USDT_ACCEPTED_TOKEN_CONTRACTS="TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
USDT_WORKER_SECRET="REPLACE_WITH_LONG_RANDOM_WORKER_SECRET"
# 生产必填：收款地址完整性校验专用密钥，至少 32 字节；不得复用 HMAC/AES/JWT/Bot Token。
PAYMENT_ADDRESS_INTEGRITY_KEY="REPLACE_WITH_A_DEDICATED_32_PLUS_BYTE_SECRET"
USDT_INTERNAL_BASE_URL="http://127.0.0.1:3000"

# Phase C controlled playback
VIDEO_DELIVERY_MODE="disabled"
PLAYBACK_SESSION_TTL_SECONDS="300"
PLAYBACK_MAX_ACTIVE_DEVICES="2"
PLAYBACK_HEARTBEAT_INTERVAL_SECONDS="15"
PLAYBACK_POC_CONTENT_IDS=""
PLAYBACK_POC_USER_IDS=""
VIDEO_CDN_BASE_URL=""
VIDEO_CDN_SIGNING_MODE="signed_cookie"
VIDEO_CDN_SIGNING_KEY="REPLACE_WITH_A_DEDICATED_24_PLUS_BYTE_PLAYBACK_SIGNING_SECRET"
ANALYTICS_EVENT_RETENTION_DAYS="180"

# Server
SERVER_PORT=3000
SESSION_SECRET="aIc_QG9gr0j95XqE9MEVGZgZEkVP1BfFoc28xT09-fg"
CORS_ORIGIN="*"
NODE_ENV="development"
# 管理员初始账号（首次 prisma:seed 时创建，已存在账号不会被覆盖；上线前务必修改默认值）
# 上线后请删除这些行，或改为与 demo 不同的强密码。
SEED_SUPERADMIN_EMAIL="superadmin@intune.local"
SEED_SUPERADMIN_PASSWORD="ChangeMeSuperAdmin!123"
SEED_OPERATOR_EMAIL="operator@intune.local"
SEED_OPERATOR_PASSWORD="ChangeMeOperator!456"
# 【废弃】旧临时 Token 方案：当前人工补单已改为管理员账号+密码登录 Session + RBAC
# 如仍想在测试脚本中使用，请额外自建带 order:mark_paid 权限的 adminUser
# ADMIN_ORDER_TOKEN="REPLACE_WITH_ADMIN_ORDER_TOKEN_AT_LEAST_32_CHARS"
# Canonical origin used only for public SEO landing pages, robots.txt and sitemap.xml.
# Keep this on the normal public Web domain. Never use media/watch/admin/API domains.
PUBLIC_WEB_ORIGIN="https://samewave.cc"
# BotFather-configured Mini App origin. It may differ from the public H5 site.
