[Unit]
Description=InTune community transcode worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/intune/app/server
EnvironmentFile=/etc/intune/intune.env
ExecStart=/usr/bin/npm run community:transcode-worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/intune/app/server /var/lib/intune-community-transcode
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
