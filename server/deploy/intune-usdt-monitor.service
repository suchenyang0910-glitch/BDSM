[Unit]
Description=InTune USDT TRC20 monitor worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/intune/app/server
EnvironmentFile=/etc/intune/intune.env
ExecStart=/usr/bin/npm run usdt:monitor
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/intune/app/server
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
