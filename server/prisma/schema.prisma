  boundAt            DateTime?             @map("bound_at")
  lastErrorCode      String?               @map("last_error_code") @db.VarChar(128)
  lastErrorNote      String?               @map("last_error_note") @db.VarChar(500)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  package            ContentPackage?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  resolvedChannel    AdminManagedChannel?  @relation("ResolvedManagedChannel", fields: [resolvedChannelId], references: [id], onDelete: SetNull)
  submittedByAdmin   AdminUser?            @relation("ChannelDiscoverySubmitAdmin", fields: [submittedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([linkType, status])
