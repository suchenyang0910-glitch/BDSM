// Prisma schema for InTune Platform
// 数据库层约束优先原则：所有业务唯一性、引用完整性、枚举值在 DB 层保证

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Enums ===

enum UserStatus {
  active
  frozen
  deleted
}

enum AccessType {
  public
  single
  package
  membership
}

enum ContentStatus {
  draft
  pending_review
  scheduled
  published
  offline
  archived
}

enum ProductType {
  single
  package
  membership
}

enum ProductStatus {
  active
  inactive
}

enum PackageStatus {
  draft
  published
  offline
}

enum CategoryStatus {
  active
  inactive
}

enum HomepageVersionStatus {
  draft
  published
  archived
}

enum BannerStatus {
  draft
  scheduled
  active
  inactive
}

enum BannerTargetType {
  content
  package
  membership
  category
  external
}

enum OrderStatus {
  pending
  processing
  paid
  failed
  refunded
  cancelled
  expired
}

enum ResourceType {
  content
  package
  membership_channel
}

enum EntitlementStatus {
  active
  revoked
  expired
}

enum EntitlementRemovalStatus {
  none
  grace_period
  removed
  removal_failed
  renewed_during_grace
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketCategory {
  payment
  entitlement
  access
  refund
  other
}

enum TicketEventType {
  created
  assigned
  note_internal
  note_public
  status_changed
  resolved
  closed
  action_taken
}

enum AdminRole {
  super_admin
  operator
  customer_service
  finance
  auditor
  editor
}

enum PaymentMethod {
  telegram_stars
  usdt_trc20_external
  manual
}

enum PaymentTransactionStatus {
  detected
  confirming
  confirmed
  rejected
  refunded
}

enum PaymentAddressStatus {
  pending_approval
  available
  assigned
  retired
}

enum AnalyticsPlatform {
  h5
  telegram_mini_app
  server
  unknown
}

enum PreferenceType {
  content_topic
  content_format
  discovery_mode
  notification
}

enum PreferenceSource {
  guest_onboarding
  my_preferences
  first_browse_prompt
  migration_confirmed
}

// === Core Tables ===

model User {
  id              String    @id @default(uuid())
  telegramUserId  BigInt?   @unique @map("telegram_user_id")
  username        String?
  displayName     String    @map("display_name")
  photoUrl        String?   @map("photo_url")
  status          UserStatus @default(active)
  mergedIntoUserId String?  @map("merged_into_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  orders          Order[]
  entitlements    Entitlement[]
  telegramInvites TelegramInvite[]
  supportTickets  SupportTicket[]
  authoredTicketEvents TicketEvent[]
  deviceSessions  H5DeviceSession[]
  analyticsEvents AnalyticsEvent[]
  contentPreferences UserContentPreference[]
  watchEvents     WatchEvent[]
  watchProgresses WatchProgress[]
  mergedFromUsers User[]    @relation("UserMergeTarget")
  mergedTargetUser User?    @relation("UserMergeTarget", fields: [mergedIntoUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mergedIntoUserId])
  @@map("users")
}

model H5DeviceSession {
  tokenHash   String   @id @map("token_hash") @db.VarChar(64)
  userId      String   @map("user_id")
  expiresAt   DateTime @map("expires_at")
  lastUsedAt  DateTime @map("last_used_at")
  createdAt   DateTime @default(now()) @map("created_at")
  createdIp   String?  @map("created_ip") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(512)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastUsedAt])
  @@map("h5_device_sessions")
}

model Category {
  id         String         @id @default(uuid())
  name       String
  slug       String         @unique
  iconUrl    String?        @map("icon_url")
  sortOrder  Int            @default(0) @map("sort_order")
  status     CategoryStatus @default(active)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  contents   ContentCategory[]
  banners    Banner[]
  preferenceSelections UserContentPreference[]

  @@index([status, sortOrder])
  @@map("categories")
}

model Banner {
  id           String           @id @default(uuid())
  title        String
  description  String?
  imageUrl     String?          @map("image_url")
  actionLabel  String           @default("查看") @map("action_label")
  slot         String           @default("home_top") @map("slot") @db.VarChar(32)
  targetType   BannerTargetType @map("target_type")
  targetId     String?          @map("target_id")
  externalUrl  String?          @map("external_url")
  sortOrder    Int              @default(0) @map("sort_order")
  startsAt     DateTime?        @map("starts_at")
  endsAt       DateTime?        @map("ends_at")
  status       BannerStatus     @default(draft)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  categoryId   String?          @map("category_id")
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, slot, sortOrder])
  @@index([startsAt, endsAt])
  @@map("banners")
}

model ContentPackage {
  id                    String        @id @default(uuid())
  title                 String
  coverUrl              String?       @map("cover_url")
  coverAssetId          String?       @map("cover_asset_id") @db.VarChar(64)
  previewAssetId        String?       @map("preview_asset_id") @db.VarChar(64)
  channelId             BigInt?       @map("channel_id")
  channelIdCiphertext   String?       @map("channel_id_ciphertext")
  channelIdHmac         String?       @map("channel_id_hmac") @db.VarChar(64)
  productId             String?       @unique @map("product_id")
  status                PackageStatus @default(draft)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  product               Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  contents              Content[]
  coverAsset            MediaAsset?   @relation("PackageCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  previewAsset          MediaAsset?   @relation("PackagePreviewAsset", fields: [previewAssetId], references: [id], onDelete: SetNull)
  publishJobs           TelegramPublishJob[]
  managedChannels       AdminManagedChannel[]
  channelDiscoveryRequests AdminChannelDiscoveryRequest[]

  @@index([status])
  @@index([coverAssetId])
  @@index([previewAssetId])
  @@unique([channelIdHmac], name: "idx_cp_channel_hmac")
  @@map("content_packages")
}

model Product {
  id            String        @id @default(uuid())
  type          ProductType
  title         String
  priceMinor    BigInt        @map("price_minor")
  currency      String        @default("XTR")
  // 商品主价格用于 Telegram Stars；可选 USDT 价格让同一权益在 H5 / Mini App
  // 走 TRC-20 支付时无需复制一份商品或改变 Stars 定价。
  usdtPriceMinor BigInt?      @map("usdt_price_minor")
  durationDays  Int?          @map("duration_days")
  status        ProductStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  contents      Content[]
  contentPackage ContentPackage?
  orders        Order[]

  @@index([status, type])
  @@map("products")
}

model Content {
  id                 String         @id @default(uuid())
  title              String
  coverUrl           String?        @map("cover_url")
  thumbnailUrl       String?        @map("thumbnail_url")
  description        String?
  tags               String[]       @default([])
  seoTitle           String?        @map("seo_title") @db.VarChar(120)
  seoDescription     String?        @map("seo_description") @db.VarChar(300)
  seoKeywords        String[]       @default([]) @map("seo_keywords")
  geoKeywords        String[]       @default([]) @map("geo_keywords")
  previewUrl         String?        @map("preview_url")
  durationSeconds    Int?           @map("duration_seconds")
  accessType         AccessType     @default(single) @map("access_type")
  status             ContentStatus  @default(draft)
  isRecommended      Boolean        @default(false) @map("is_recommended")
  isFeatured         Boolean        @default(false) @map("is_featured")
  isNewArrival       Boolean        @default(false) @map("is_new_arrival")
  featuredSort       Int?           @map("featured_sort")
  sortOrder          Int            @default(0) @map("sort_order")
  recommendStartsAt  DateTime?      @map("recommend_starts_at")
  recommendEndsAt    DateTime?      @map("recommend_ends_at")
  scheduledAt        DateTime?        @map("scheduled_at")
  freeChannelCode    String?          @map("free_channel_code") @db.VarChar(64)
  channelId          BigInt?          @map("channel_id")
  channelIdCiphertext String?         @map("channel_id_ciphertext")
  channelIdHmac      String?          @map("channel_id_hmac") @db.VarChar(64)
  packageId          String?          @map("package_id")
  productId          String?        @map("product_id")
  coverAssetId       String?          @map("cover_asset_id") @db.VarChar(64)
  previewAssetId     String?          @map("preview_asset_id") @db.VarChar(64)
  fullVideoAssetId   String?          @map("full_video_asset_id") @db.VarChar(64)
  publishedAt        DateTime?      @map("published_at")
  telegramMessageId  BigInt?          @map("telegram_message_id")
  telegramSentAt     DateTime?        @map("telegram_sent_at")
  telegramChatFingerprint String?   @map("telegram_chat_fingerprint") @db.VarChar(128)
  lastEditorId       String?        @map("last_editor_id")
  version            Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  package            ContentPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  product            Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastEditor         AdminUser?     @relation("ContentEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  categories         ContentCategory[]
  coverAsset         MediaAsset?    @relation("ContentCoverAsset", fields: [coverAssetId], references: [id], onDelete: SetNull)
  previewAsset       MediaAsset?    @relation("ContentPreviewAsset", fields: [previewAssetId], references: [id], onDelete: SetNull)
  fullVideoAsset     MediaAsset?    @relation("ContentFullVideoAsset", fields: [fullVideoAssetId], references: [id], onDelete: SetNull)
  fullVideoSegments  ContentFullVideoSegment[]
  publishJobs        TelegramPublishJob[]
  linkedChannelMessages TelegramChannelMessage[]
  videoAssets        VideoAsset[]
  uploadSessions     UploadSession[]
  transcodeJobs      TranscodeJob[]
  watchEvents        WatchEvent[]
  watchProgresses    WatchProgress[]

  @@index([status, accessType])
  @@index([isFeatured, featuredSort])
  @@index([isRecommended, recommendStartsAt, recommendEndsAt])
  @@index([sortOrder])
  @@index([packageId])
  @@index([freeChannelCode])
  @@index([channelIdHmac], name: "idx_content_channel_hmac")
  @@index([coverAssetId])
  @@index([previewAssetId])
  @@index([fullVideoAssetId])
  @@map("contents")
}

model PlatformMetadata {
  id               String   @id @default("default")
  seoTitle         String?  @map("seo_title") @db.VarChar(120)
  seoDescription   String?  @map("seo_description") @db.VarChar(300)
  seoKeywords      String[] @default([]) @map("seo_keywords")
  geoKeywords      String[] @default([]) @map("geo_keywords")
  updatedAt        DateTime @updatedAt @map("updated_at")
  updatedBy        String?  @map("updated_by")

  @@map("platform_metadata")
}

model AnalyticsEvent {
  id               String            @id @default(uuid())
  occurredAt       DateTime          @map("occurred_at")
  eventName        String            @map("event_name") @db.VarChar(64)
  userId           String?           @map("user_id")
  anonymousIdHmac  String            @map("anonymous_id_hmac") @db.VarChar(64)
  userIdHmac       String?           @map("user_id_hmac") @db.VarChar(64)
  sessionIdHmac    String            @map("session_id_hmac") @db.VarChar(64)
  platform         AnalyticsPlatform @default(unknown)
  propertiesJson   Json?             @map("properties_json")
  createdAt        DateTime          @default(now()) @map("created_at")

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventName, occurredAt])
  @@index([platform, eventName, occurredAt])
  @@index([sessionIdHmac, occurredAt])
  @@index([anonymousIdHmac, occurredAt])
  @@index([userId, occurredAt])
  @@map("analytics_events")
}

model AnalyticsDailyAggregate {
  id                String            @id @default(uuid())
  statDate          DateTime          @map("stat_date") @db.Date
  eventName         String            @map("event_name") @db.VarChar(64)
  platform          AnalyticsPlatform @default(unknown)
  groupKey          String?           @map("group_key") @db.VarChar(64)
  groupValue        String?           @map("group_value") @db.VarChar(128)
  sampleCount       Int               @default(0) @map("sample_count")
  uniqueSessions    Int               @default(0) @map("unique_sessions")
  uniqueAnonymous   Int               @default(0) @map("unique_anonymous")
  uniqueUsers       Int               @default(0) @map("unique_users")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@index([statDate, eventName])
  @@index([platform, statDate])
  @@index([groupKey, groupValue, statDate])
  @@map("analytics_daily_aggregates")
}

model UserContentPreference {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  categoryId      String?          @map("category_id")
  preferenceType  PreferenceType   @map("preference_type")
  valueKey        String           @map("value_key") @db.VarChar(64)
  isEnabled       Boolean          @default(true) @map("is_enabled")
  source          PreferenceSource @default(my_preferences)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, preferenceType, isEnabled])
  @@index([categoryId, preferenceType])
  @@map("user_content_preferences")
}

model ContentCategory {
  contentId    String   @map("content_id")
  categoryId   String   @map("category_id")
  displayOrder Int      @default(0) @map("display_order")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedBy   String?  @map("assigned_by")

  content      Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  assigner     AdminUser? @relation(fields: [assignedBy], references: [id], onDelete: SetNull)

  @@id([contentId, categoryId])
  @@index([categoryId])
  @@index([displayOrder])
  @@map("content_categories")
}

model Order {
  id                    String          @id @default(uuid())
  orderNo               String          @unique @map("order_no")
  userId                String          @map("user_id")
  productId             String          @map("product_id")
  amountMinor           BigInt          @map("amount_minor")
  currency              String          @default("XTR")
  paymentMethod         PaymentMethod   @default(telegram_stars) @map("payment_method")
  paymentProvider       String          @default("telegram_stars") @map("payment_provider")
  providerOrderId       String?         @unique @map("provider_order_id")
  paymentPayloadHmac    String?         @unique @map("payment_payload_hmac") @db.VarChar(64)
  telegramUserIdHmac    String?         @map("telegram_user_id_hmac") @db.VarChar(64)
  expiresAt             DateTime?       @map("expires_at")
  status                OrderStatus     @default(pending)
  paidAt                DateTime?       @map("paid_at")
  rejectedAt            DateTime?       @map("rejected_at")
  rejectReason          String?         @map("reject_reason") @db.VarChar(128)
  refundedAt            DateTime?       @map("refunded_at")
  refundReason          String?         @map("refund_reason") @db.VarChar(1000)
  refundAdminId         String?         @map("refund_admin_id") @db.VarChar(64)
  telegramStarsInvoiceLink String?       @map("telegram_stars_invoice_link") @db.VarChar(512)
  telegramStarsInvoiceVia  String?       @map("telegram_stars_invoice_via") @db.VarChar(32)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  user                  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  product               Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  entitlements          Entitlement[]
  supportTickets        SupportTicket[]
  paymentTransactions   PaymentTransaction[]
  usdtPaymentAddress    PaymentAddress? @relation(fields: [usdtPaymentAddressId], references: [id])
  usdtPaymentAddressId  String?         @map("usdt_payment_address_id")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod, status, createdAt])
  @@index([expiresAt, status])
  @@index([usdtPaymentAddressId, status])
  @@map("orders")
}

model PaymentTransaction {
  id                  String                    @id @default(uuid())
  orderId             String                    @map("order_id")
  provider            String                    @map("provider")
  status              PaymentTransactionStatus  @default(detected)
  providerChargeId    String?                   @unique @map("provider_charge_id") @db.VarChar(256)
  network             String?                   @map("network") @db.VarChar(32)
  tokenContract       String?                   @map("token_contract") @db.VarChar(64)
  toAddress           String?                   @map("to_address") @db.VarChar(64)
  fromAddress         String?                   @map("from_address") @db.VarChar(64)
  amountMinor         BigInt                    @map("amount_minor")
  currency            String                    @default("XTR") @db.VarChar(16)
  confirmations       Int?                      @map("confirmations")
  confirmationsTarget Int?                      @map("confirmations_target")
  rawEventHash        String                    @unique @map("raw_event_hash") @db.VarChar(64)
  telegramPayloadHmac String?                   @map("telegram_payload_hmac") @db.VarChar(64)
  blockNumber         BigInt?                   @map("block_number")
  receivedAt          DateTime                  @default(now()) @map("received_at")
  confirmedAt         DateTime?                 @map("confirmed_at")
  rejectedAt          DateTime?                 @map("rejected_at")
  rejectReason        String?                   @map("reject_reason") @db.VarChar(128)
  refundedAt          DateTime?                 @map("refunded_at")
  refundReason        String?                   @map("refund_reason") @db.VarChar(1000)
  refundAdminId       String?                   @map("refund_admin_id") @db.VarChar(64)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  order               Order                     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@index([toAddress, status])
  @@index([blockNumber])
  @@map("payment_transactions")
}

model PaymentAddress {
  id               String               @id @default(uuid())
  network          String               @default("tron_trc20") @map("network") @db.VarChar(32)
  address          String               @unique @map("address") @db.VarChar(64)
  addressMasked    String               @map("address_masked") @db.VarChar(16)
  status           PaymentAddressStatus @default(pending_approval) @map("status")
  assignedOrderId  String?              @unique @map("assigned_order_id")
  assignedAt       DateTime?            @map("assigned_at")
  releaseAt        DateTime?            @map("release_at")
  retiredAt        DateTime?            @map("retired_at")
  retireReason     String?              @map("retire_reason") @db.VarChar(128)
  createdBy        String?              @map("created_by")
  approvedBy       String?              @map("approved_by")
  approvedAt       DateTime?            @map("approved_at")
  activationReadyAt DateTime?           @map("activation_ready_at")
  lifecycleVersion Int                  @default(1) @map("lifecycle_version")
  integrityMac     String?              @map("integrity_mac") @db.VarChar(64)
  autoCreditFrozenAt DateTime?          @map("auto_credit_frozen_at")
  autoCreditFreezeReason String?        @map("auto_credit_freeze_reason") @db.VarChar(128)
  lastIntegrityCheckAt DateTime?        @map("last_integrity_check_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  assignedOrders   Order[]
  monitorCursor    UsdtMonitorCursor?

  @@index([network, status])
  @@index([status, releaseAt])
  @@map("payment_addresses")
}

model UsdtMonitorCursor {
  addressId              String        @id @map("address_id")
  lastBlockTimestamp     DateTime?     @map("last_block_timestamp")
  lastTxHashFingerprint  String?       @map("last_tx_hash_fingerprint") @db.VarChar(64)
  lastSuccessAt          DateTime?     @map("last_success_at")
  lastErrorClass         String?       @map("last_error_class") @db.VarChar(64)
  consecutiveFailures    Int           @default(0) @map("consecutive_failures")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  paymentAddress         PaymentAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@index([lastSuccessAt])
  @@index([consecutiveFailures, updatedAt])
  @@map("usdt_monitor_cursors")
}

model UsdtMonitorRuntimeState {
  workerName             String    @id @map("worker_name") @db.VarChar(64)
  lastCycleAt            DateTime? @map("last_cycle_at")
  lastSuccessAt          DateTime? @map("last_success_at")
  lastBlockNumber        BigInt?   @map("last_block_number")
  lastScannedAddressCount Int      @default(0) @map("last_scanned_address_count")
  lastDiscoveredTxCount  Int       @default(0) @map("last_discovered_tx_count")
  lastConfirmedCount     Int       @default(0) @map("last_confirmed_count")
  lastRejectedCount      Int       @default(0) @map("last_rejected_count")
  consecutiveFailures    Int       @default(0) @map("consecutive_failures")
  lastErrorClass         String?   @map("last_error_class") @db.VarChar(64)
  lastProviderStatus     String?   @map("last_provider_status") @db.VarChar(32)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("usdt_monitor_runtime_states")
}

model Entitlement {
  id             String            @id @default(uuid())
  userId         String            @map("user_id")
  resourceType   ResourceType      @map("resource_type")
  resourceId     String            @map("resource_id")
  sourceOrderId  String?           @map("source_order_id")
  startsAt       DateTime          @default(now()) @map("starts_at")
  expiresAt      DateTime?         @map("expires_at")
  status         EntitlementStatus @default(active)
  notify3dAt     DateTime?         @map("notify_3d_at")
  notifyExpiredAt DateTime?        @map("notify_expired_at")
  graceEndsAt    DateTime?         @map("grace_ends_at")
  expiryReminderAt DateTime?       @map("expiry_reminder_at")
  preGraceReminderAt DateTime?     @map("pre_grace_reminder_at")
  expiryReminderCount Int          @default(0) @map("expiry_reminder_count")
  removalStatus  EntitlementRemovalStatus @default(none) @map("removal_status")
  removalAttemptedAt DateTime?     @map("removal_attempted_at")
  removedAt      DateTime?         @map("removed_at")
  lastRemovalErrorCode String?     @map("last_removal_error_code") @db.VarChar(128)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceOrder    Order?            @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  telegramInvites TelegramInvite[]
  supportTickets SupportTicket[]

  @@index([userId, status])
  @@index([resourceType, resourceId])
  @@index([expiresAt, status])
  @@index([notify3dAt, expiresAt, status])
  @@index([notifyExpiredAt, expiresAt, status])
  @@index([graceEndsAt, removalStatus])
  @@index([resourceType, resourceId, userId, removalStatus])
  @@map("entitlements")
}

model TelegramInvite {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
