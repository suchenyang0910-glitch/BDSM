enum ManagedChannelPurpose {
  none
  free_preview
  membership_main
  package_channel
}

model AdminManagedChannel {
  // 【Phase 0-1 已锁定】频道 ID 加密存储
  //   id                   = UUID 主键（不可反推 chatId；同时禁止把 UUID 写进审计日志当作可解密引用）
  //   deprecatedChatIdBig  = 过渡明文列（下一迁移 000X 必 DROP；仅用于迁移期数据回滚对照）
  //   chatIdCiphertextB64  = AES-256-GCM 密文列（base64: nonce12 || tag16 || ciphertext）
  //   chatIdHmac           = HMAC-SHA-256 索引键（UNIQUE，用于 where 精准查找 / 去重）
  id                  String                  @id @default(uuid())
  deprecatedChatIdBig BigInt?                 @map("deprecated_chat_id_big") @db.BigInt
  chatIdCiphertextB64 String                  @map("chat_id_ciphertext_b64") @db.Text
  chatIdHmac          String                  @map("chat_id_hmac") @db.VarChar(64)
  chatType            String                  @map("chat_type") // channel | supergroup | group | private
  title               String?
  username            String?
  memberCount         Int?                    @map("member_count")
  avatarFileId        String?                 @map("avatar_file_id")
  isPrivate           Boolean                 @default(true) @map("is_private")
  purpose             ManagedChannelPurpose   @default(none) @map("purpose")
  packageId           String?                 @map("package_id")
  publicUrl           String?                 @map("public_url")
  botIsAdmin          Boolean                 @default(false) @map("bot_is_admin")
  botCanPostMessages  Boolean                 @default(false) @map("bot_can_post_messages")
  botCanInviteUsers   Boolean                 @default(false) @map("bot_can_invite_users")
  botCanRestrictMembers Boolean               @default(false) @map("bot_can_restrict_members")
  lastDiscoveryUpdateType String?             @map("last_discovery_update_type") @db.VarChar(64)
  discoveryErrorCode  String?                 @map("discovery_error_code") @db.VarChar(128)
  lastEventAt         DateTime?               @map("last_event_at")
  refreshedAt         DateTime?               @map("refreshed_at")
  source              AdminManagedChatSource  @default(auto_scan)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  package             ContentPackage?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  discoveryRequests   AdminChannelDiscoveryRequest[] @relation("ResolvedManagedChannel")
  channelMessages     TelegramChannelMessage[]

  @@unique([chatIdHmac], map: "admin_managed_channels_chat_id_hmac_key")
  @@unique([packageId], map: "admin_managed_channels_package_id_key")
  @@index([source])
  @@index([chatType])
  @@index([purpose])
  @@index([refreshedAt])
  @@map("admin_managed_channels")
}

model AdminChannelDiscoveryRequest {
  id                 String                @id @default(uuid())
  submittedLink      String                @map("submitted_link")
  normalizedLink     String?               @map("normalized_link")
  linkType           ChannelDiscoveryLinkType @map("link_type")
  status             ChannelDiscoveryStatus @default(awaiting_bot_admin)
