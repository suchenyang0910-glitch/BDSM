{
  "name": "intune-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "usdt:monitor": "tsx src/workers/usdtTrc20Monitor.ts",
    "payment-address:baseline": "tsx src/scripts/establishPaymentAddressIntegrityBaseline.ts",
    "delivery:validate-channels": "tsx src/scripts/validateDeliveryChannels.ts",
    "telegram:pin-mini-app": "tsx src/scripts/pinMiniAppEntrypoint.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/pseudonym.test.ts tests/telegram.test.ts tests/pin-mini-app.test.ts tests/object-storage.test.ts tests/api-smoke.test.ts tests/entitlements.test.ts tests/orders.test.ts tests/admin-permissions.test.ts tests/smoke-sprint2.test.ts tests/s1-content-access.test.ts tests/usdt-monitor.test.ts tests/analytics-finance.test.ts tests/vod-phase-a-media.test.ts tests/migration-0027-rehearsal.test.ts tests/watch-progress.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/session": "^11.0.0",
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.2.0",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
