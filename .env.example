# PostgreSQL —— 可公开，docker-compose 与 server 都读它
POSTGRES_USER=intune
POSTGRES_PASSWORD=intune_dev_password
POSTGRES_DB=intune
POSTGRES_PORT=5432
DATABASE_URL="postgresql://intune:intune_dev_password@localhost:5432/intune?schema=public"

# Telegram —— 公开信息可写示例
TELEGRAM_BOT_USERNAME="InTune_bdsm_bot"
PUBLIC_CHANNEL_URL="https://t.me/InTune_bdsm"

# Telegram —— 敏感信息：只允许复制到实际部署的 server/.env，不要把真实值提交进仓库
# ⚠️  TELEGRAM_BOTS = 受控登录 Bot 白名单；每个 Token 仅存在于部署环境，不提交仓库
# ⚠️  TELEGRAM_CHANNEL_* = 收费私密频道的数字 ID（以 -100 开头的长整数），绝对不要写进前端或群聊
# 示例占位：真实值替换后不要提交
TELEGRAM_BOTS='[{"key":"primary","username":"InTune_bdsm_bot","token":"123456789:AAH_REPLACE_PRIMARY_TOKEN","active":true},{"key":"backup","username":"InTune_backup_bot","token":"123456789:AAH_REPLACE_BACKUP_TOKEN","active":true}]'
TELEGRAM_INVITE_BOT_KEY="primary"
TELEGRAM_CHANNEL_MEMBERSHIP="-1000000000001"
TELEGRAM_CHANNEL_PACKAGE_FEATURED="-1000000000002"
# 如有更多收费频道，按 TELEGRAM_CHANNEL_<用途> 命名，真实值只存 env

# Server
SERVER_PORT=3000
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
CORS_ORIGIN="*"
COMMUNITY_ENABLED="false"
COMMUNITY_POSTING_ENABLED="false"
COMMUNITY_VIDEO_UPLOAD_ENABLED="false"
COMMUNITY_MAX_IMAGES_PER_POST=9
COMMUNITY_MAX_VIDEO_BYTES=314572800
COMMUNITY_MAX_VIDEO_UPLOADS_PER_DAY=1

# Admin 初始密码（bcrypt 哈希，不要放明文）
ADMIN_EMAIL="admin@intune.local"
ADMIN_PASSWORD_HASH=""

# Node
NODE_ENV="development"
